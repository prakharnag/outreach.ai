{
  "name": "outreach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "playwright test",
    "test:integration:ui": "playwright test --ui",
    "test:integration:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:integration",
    "test:ci": "npm run test && npm run test:integration --reporter=github",
    "postinstall": "tailwindcss -v >/dev/null 2>&1 || true",
    "drizzle:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "drizzle:push": "drizzle-kit push --config=drizzle.config.ts"
  },
